datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  username        String           @unique
  firstName       String
  lastName        String
  password        String
  role            String           @default("ADMIN") // "SUPER_ADMIN" | "ADMIN" | "COBRANZA"
  collectionCalls CollectionCall[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model BcvRate {
  id        String   @id @default(uuid())
  rate      Float
  eurRate   Float    @default(0)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model SchoolConfig {
  id                    String  @id @default("default")
  name                  String  @default("Colegio Ramón Pierluissi")
  rif                   String  @default("J-31489201-4")
  phone                 String  @default("+58 414-7890123")
  email                 String  @default("admonpierluissi@gmail.com")
  address               String  @default("Prebo II, Valencia, Carabobo")
  pagoMovilBank         String  @default("Banesco (0134)")
  pagoMovilPhone        String  @default("0414-7890123")
  pagoMovilRif          String  @default("J-31489201-4")
  zelleEmail            String  @default("pagos@colegioramonpierluissi.com")
  zelleName             String  @default("Colegio Ramón Pierluissi C.A.")
  totalPagoApiKey       String?
  totalPagoMerchantId   String?
  provincialC2PKey      String?
  standardMonthlyFeeEur Float   @default(270.0)
  earlyPaymentDayCutoff Int     @default(10)
  earlyPaymentFeeEur    Float   @default(256.0)
  latePaymentFeeEur     Float   @default(280.0)
}

model Representative {
  id        String    @id @default(uuid())
  name      String
  cedula    String    @unique
  phone     String
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
}

model Grade {
  id            String    @id @default(uuid())
  name          String
  section       String
  monthlyFeeUsd Float
  students      Student[]
}

model Student {
  id                 String         @id @default(uuid())
  firstName          String
  lastName           String
  cedula             String         @unique
  scholarshipPercent Float          @default(0)
  status             String         @default("ACTIVE")
  representativeId   String
  representative     Representative @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  gradeId            String
  grade              Grade          @relation(fields: [gradeId], references: [id])
  fees               StudentFee[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model FeeConcept {
  id               String   @id @default(uuid())
  name             String
  defaultAmountUsd Float
  dueDate          DateTime
  createdAt        DateTime @default(now())
}

model StudentFee {
  id          String           @id @default(uuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptName String
  currency    String           @default("USD")
  amountUsd   Float
  paidUsd     Float            @default(0)
  dueDate     DateTime
  status      String           @default("PENDING")
  payments    Payment[]
  calls       CollectionCall[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CollectionCall {
  id           String     @id @default(uuid())
  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  operatorName String     @default("Personal de Cobranza")
  status       String     // "CONTACTED" | "NO_ANSWER"
  notes        String?    // Ej: "Mañana realiza el pago por Pago Móvil"
  result       String     @default("PENDING") // "PENDING" | "CONVERTED_PAID"
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
}

model Payment {
  id            String     @id @default(uuid())
  studentFeeId  String
  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  paymentDate   DateTime   @default(now())
  method        String
  currency      String     @default("USD")
  reference     String?
  amountUsd     Float
  amountVes     Float
  bcvRate       Float
  notes         String?
  receiptNumber String     @unique
  createdAt     DateTime   @default(now())
}
